  "ElementalistLine1Placeholder": "Abrace o poder dos",
  "ElementalistLine2Placeholder": "elementos com avidez. Receba tudo",
  "ElementalistLine3Placeholder": "que oferecem e libere o",
  "ElementalistLine4Placeholder": "verdadeiro potencial dos feitiços.",
  "ElementalistLine5Placeholder": "",
  "ElementalistLine6Placeholder": "",
  "BattleMageLine1Placeholder": "Aprenda a dança dos elementos,",
  "BattleMageLine2Placeholder": "o fluxo harmonioso entre magia",
  "BattleMageLine3Placeholder": "e força física. Faça do seu",
  "BattleMageLine4Placeholder": "cajado de batalha uma extensão",
  "BattleMageLine5Placeholder": "de sua habilidade mágica.",
  "BattleMageLine6Placeholder": "",
  "ClericLine1Placeholder": "Entre em plena sintonia com o",
  "ClericLine2Placeholder": "Éter, renuncie à tentação da",
  "ClericLine3Placeholder": "magia sombria. Faça do Éter",
  "ClericLine4Placeholder": "uma fonte de energia da qual",
  "ClericLine5Placeholder": "possa beber livremente e deixe-o",
  "ClericLine6Placeholder": "aprimorar sua magia restauradora.",
  "OccultistLine1Placeholder": "Abrace o Abismo, use seu poder",
  "OccultistLine2Placeholder": "para fortalecer a si e",
  "OccultistLine3Placeholder": "a seus aliados. Você pode usar",
  "OccultistLine4Placeholder": "a própria força vital dos inimigos",
  "OccultistLine5Placeholder": "para alimentar seus feitiços,",
  "OccultistLine6Placeholder": "basta recorrer à escuridão.",
  "RangerLine1Placeholder": "Mestres da caça e da exploração,",
  "RangerLine2Placeholder": "patrulheiros se especializam em",
  "RangerLine3Placeholder": "identificar as fraquezas",
  "RangerLine4Placeholder": "de seus oponentes e atacar",
  "RangerLine5Placeholder": "onde for mais eficaz.",
  "RangerLine6Placeholder": "",
  "ValkyrieLine1Placeholder": "Unindo força física e magia,",
  "ValkyrieLine2Placeholder": "valquírias compreendem que o",
  "ValkyrieLine3Placeholder": "Éter flui por todas as coisas"
