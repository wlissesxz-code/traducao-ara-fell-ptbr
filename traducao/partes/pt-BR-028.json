{
  "180.2.0.15": "Não",
  "180.2.0.18": "\"Não, desculpe.\"",
  "180.2.0.28": "\"Voltaram, e aparentemente",
  "180.2.0.29": "inteiros. Tiveram sorte?\"",
  "180.2.0.33": "Ser honesta e entregar o item...",
  "180.2.0.36": "\"Encontramos! Aqui está.\"",
  "180.2.0.41": "\"Que maravilha! Muito obrigado.",
  "180.2.0.42": "Acredito que este anel deva ser levado",
  "180.2.0.43": "ao \\c[9]Templo de Orlian\\c[0] para ser estudado.\"",
  "180.2.0.44": "\"Eu mesmo o levarei.",
  "180.2.0.45": "Obrigado de novo.\"",
  "180.2.0.56": "Mentir e ficar com ele...",
  "180.2.0.60": "\"Nós, hã... exploramos o lugar inteiro,",
  "180.2.0.61": "mas não havia nenhum tesouro.\"",
  "180.2.0.64": "\"Não? Eu podia jurar... Bem,",
  "180.2.0.65": "agradeço por terem procurado.",
  "180.2.0.66": "Vou pagar pelo seu tempo.\"",
  "180.2.0.75": "Mentir, mas talvez devolver depois...",
  "180.2.0.78": "\"Ah... ainda não. Aviso",
  "180.2.0.79": "se encontrar alguma coisa.\"",
  "180.2.0.86": "\"Ainda não, desculpe. Aviso",
  "180.2.0.87": "se encontrar alguma coisa.\"",
  "180.2.0.94": "\"Olá. Vocês parecem",
  "180.2.0.95": "aventureiros. Poderiam",
  "180.2.0.96": "me fazer um favor?\"",
  "180.2.0.99": "Claro!",
  "180.2.0.102": "\"Talvez! Do que precisa?\"",
  "180.2.0.105": "\"Bem, ouvi dizer que há algum tipo",
  "180.2.0.106": "de tesouro no fundo deste poço.",
  "180.2.0.107": "Procurem por ele e eu pagarei.\"",
  "180.2.0.108": "\"Pode ser perigoso lá embaixo,",
  "180.2.0.109": "então tenham cuidado se forem.\"",
  "180.2.0.113": "\"Eu... acho que talvez já esteja",
  "180.2.0.114": "com ele, na verdade. É este anel?\"",
  "180.2.0.117": "\"Está mesmo! Bem, ele tem",
  "180.2.0.118": "importância histórica.",
  "180.2.0.119": "Aceitaria me vender?\"",
  "180.2.0.122": "Sim",
  "180.2.0.125": "\"Claro, se é importante,",
  "180.2.0.126": "pode ficar com ele.\"",
  "180.2.0.129": "Não",
  "180.2.0.132": "\"Parece bem poderoso. Acho",
  "180.2.0.133": "que devo ficar com ele. Desculpe...\"",
  "180.2.0.136": "\"Entendo. Bem, se mudar",
  "180.2.0.137": "de ideia, me avise.",
  "180.2.0.138": "Farei valer a pena.\"",
  "180.2.0.146": "\"Podemos fazer isso!\\. O que poderia dar",
  "180.2.0.147": "errado explorando um simples poço??\"",
  "180.2.0.150": "\"Excelente, excelente!\\.\\.",
  "180.2.0.151": "Avisem se encontrarem!\"",
  "180.2.0.157": "Não, obrigado.",
  "180.2.0.160": "\"Ah, desculpe, não sei",
  "180.2.0.161": "se devíamos fazer bicos agora.\"",
  "180.2.0.164": "\"Entendo. É uma tarefa meio",
  "180.2.0.165": "perigosa, de qualquer forma.\"",
  "92.103.0.15": "\"Que som foi esse?\"",
  "92.103.0.17": "\"Foi\\..\\..\\.. uma risada?\"",
  "92.174.0.11": "\"Que som foi esse?\"",
  "92.174.0.13": "\"Foi\\..\\..\\.. uma risada?\"",
  "92.178.0.16": "\"Uau, olhem este lugar!\"",
  "92.178.0.19": "\"Faz um tempo que não venho",
  "92.178.0.20": "aqui. Pelo menos é uma boa",
  "92.178.0.21": "mudança depois de tanta neve.\"",
  "92.178.0.24": "\"Fiz uma expedição aqui há pouco",
  "92.178.0.25": "tempo, então conheço um pouco",
  "92.178.0.26": "o terreno e alguns dos perigos.\"",
  "92.178.0.28": "\"Tudo que vale a pena ver fica ao sul",
  "92.178.0.29": "daqui. Há um lugar chamado 'Primeiros",
  "92.178.0.30": "Passos' a oeste, junto do Bosque",
  "92.178.0.31": "de Itora. A Cidade dos Anjos fica a leste.\"",
  "92.178.0.32": "\"Não é mais muita coisa como",
  "92.178.0.33": "cidade, se querem saber.\"",
  "92.178.0.36": "\"Asari disse em que parte da \\c[9]Terra",
  "92.178.0.37": "Sagrada\\c[0] esperaria você, Lita?\"",
  "92.178.0.40": "\"Não. Só disse '\\c[9]Terra Sagrada\\c[0]'.\"",
  "92.178.0.43": "\"Então temos uma longa busca",
  "92.178.0.44": "pela frente. Vamos andando.\"",
  "94.15.0.2": "Prosseguir...",
  "94.15.0.4": "Prosseguir, mas pular a cena.",
  "94.15.0.14": "Voltar.",
  "94.16.0.2": "Prosseguir...",
  "94.16.0.4": "Prosseguir, mas pular a cena.",
  "94.16.0.14": "Voltar.",
  "94.109.0.2": "\"É bem bonito aqui, não",
  "94.109.0.3": "acham? Bem, precisam",
  "94.109.0.4": "de alguma coisa?\"",
  "94.136.0.0": "$v Bosque de Itora, Primeiros",
  "94.136.0.1": "Passos $t Cidade dos Anjos",
  "94.137.0.0": "$s Bosque de Itora",
  "94.142.0.6": "\"É aquele som de novo...\"",
  "94.142.0.9": "\"Ei! Quem está aí??\"",
  "94.142.0.18": "\"\\..\\..\\..\"",
  "94.142.0.26": "\"AHÁ!!\"",
  "94.142.0.29": "\"...\\| Eu podia jurar...\"",
  "94.142.0.31": "\"A menos que...\"",
  "94.142.0.38": "\"PEGUEI!!\"",
  "94.142.0.49": "\"Uau! O que eram aquelas coisas??\"",
  "94.142.0.54": "\"Pareciam...\\| insetos peludos",
  "94.142.0.55": "enormes ou algo assim.\"",
  "94.142.0.60": "\"Na verdade, são fadas.",
  "94.142.0.61": "A \\c[9]Terra Sagrada\\c[0] é o lar delas.\"",
  "94.142.0.65": "\"É mesmo? Interessante. Achei que as fadas",
  "94.142.0.66": "tivessem desaparecido há muito tempo.\"",
  "94.142.0.69": "\"Não, só passaram a se esconder.",
  "94.142.0.70": "Restam poucas e raramente",
  "94.142.0.71": "se mostram aos humanos...\"",
  "94.142.0.73": "\"Talvez tenham sentido os \\c[9]Artefatos",
  "94.142.0.74": "de Poder\\c[0] que carregamos?",
  "94.142.0.75": "Ou talvez seja coincidência.\"",
  "94.142.0.79": "\"Bem, isso deve tornar as coisas",
  "94.142.0.80": "interessantes. Toda história de fadas",
  "94.142.0.81": "envolve travessuras com magia.\"",
  "94.142.0.82": "\"Continuaremos procurando Asari, mas",
  "94.142.0.83": "sugiro que fiquemos atentos... Se essas",
  "94.142.0.84": "criaturas pretendem pregar peças,",
  "94.142.0.85": "suspeito que seremos seus alvos...\"",
  "94.142.0.92": "\"Ainda acho que são insetos.\"",
  "94.149.0.0": "$v Primeiros Passos",
  "94.150.0.0": "$t Cidade dos Anjos",
  "94.215.0.3": "Teleporte da \\c[9]Terra Sagrada\\c[0] desbloqueado!",
  "94.215.2.2": "Parece que o poder deste cristal mágico",
  "94.215.2.3": "foi temporariamente desativado...",
  "94.215.2.9": "Teleporte da \\c[9]Terra Sagrada\\c[0] desbloqueado!",
  "94.215.2.10": "Parece que o poder deste cristal mágico",
  "94.215.2.11": "foi temporariamente desativado, mas",
  "94.215.2.12": "o local foi ativado para uso posterior.",
  "95.82.0.4": "\"Este deve ser o \\c[9]Artefato de Poder\\c[0]",
  "95.82.0.5": "de que a fada falou. Por que está",
  "95.82.0.6": "só... largado aqui ao ar livre?\"",
  "95.82.0.9": "Pegar o Artefato...",
  "95.82.0.12": "Ainda não...",
  "95.82.0.44": "\"O que essa coisa faz aqui?\"",
  "95.82.0.46": "\"Sabe, parece que não tenho",
  "95.82.0.47": "muita sorte pegando coisas",
  "95.82.0.48": "aleatórias assim. Talvez seja melhor",
  "95.82.0.49": "deixar para lá por enquanto.\"",
  "96.50.0.7": "\"Lá está de novo...\"",
  "96.50.0.11": "\"CERTO! Seja lá o que forem,",
  "96.50.0.12": "é melhor aparecerem!!\"",
  "96.50.0.22": "\"Não precisa ficar tão",
  "96.50.0.23": "irritada, senhorita!\"",
  "96.50.0.26": "\"Ah\\..\\..\\.. Aww! Que fofinha!\"",
  "96.50.0.30": "\"Vocês são quem a elfa boazinha",
  "96.50.0.31": "está esperando, não são?\"",
  "96.50.0.34": "\"Espero que esteja falando da Asari...\"",
  "96.50.0.37": "\"É esse o nome dela! Está no Bosque",
  "96.50.0.38": "de Itora agora, mas selamos",
  "96.50.0.39": "a entrada para ela não se machucar.\"",
  "96.50.0.40": "\"Há coisas malignas atrás dela.",
  "96.50.0.41": "Não vamos deixar que a peguem!\"",
  "96.50.0.44": "\"Bem! Meu nome é Lita e preciso",
  "96.50.0.45": "encontrar ela aqui, então será que pode",
  "96.50.0.46": "baixar aquela barreira para mim?\"",
  "96.50.0.49": "\"E se vocês não forem quem",
  "96.50.0.50": "dizem? E se forem as pessoas",
  "96.50.0.51": "más que querem matar ela?\"",
  "96.50.0.54": "\"Este anel preso no meu",
  "96.50.0.55": "dedo não significa nada?\"",
  "96.50.0.58": "\"O \\c[9]Anel de Dian\\c[0]? Para nós, não!",
  "96.50.0.59": "Mas outra coisa daqui significa:",
  "96.50.0.60": "um dos outros \\c[9]Artefatos de Poder\\c[0].\"",
  "96.50.0.61": "\"Se trouxer para mim,",
  "96.50.0.62": "rompo o selo para você!\"",
  "96.50.0.65": "\"Sempre tem um porém. Bem,",
  "96.50.0.66": "pelo menos é algo de que eu já",
  "96.50.0.67": "precisava. Certo, onde está?\"",
  "96.50.0.70": "\"Num lugar que os elfos chamaram",
  "96.50.0.71": "de Cidade dos Anjos. Não é mais muita",
  "96.50.0.72": "coisa como cidade. Fica a leste daqui!\"",
  "96.50.0.75": "\"Certo, está bem.",
  "96.50.0.76": "Volto já. Não saia daí.\"",
  "96.50.0.88": "\"Vou esperar bem aqui!\"",
  "96.71.0.4": "\"Olá! Está com o",
  "96.71.0.5": "\\c[9]Artefato de Poder\\c[0]?\"",
  "96.71.0.8": "\"SUA PESTE! VOCÊ NOS ENGANOU!\"",
  "96.71.0.11": "\"Ah, não fique brava! Precisávamos ter",
  "96.71.0.12": "certeza de que vocês eram quem diziam.\"",
  "96.71.0.13": "\"Não sei se descobrimos",
  "96.71.0.14": "mesmo, mas aqueles monstros",
  "96.71.0.15": "eram um problemão. Obrigada",
  "96.71.0.16": "por cuidarem deles para nós!\"",
  "96.71.0.19": "\"É, ótimo, de nada. Chega",
  "96.71.0.20": "de truques, está bem?\"",
  "96.71.0.23": "\"Prometo! Vou pedir às minhas irmãs",
  "96.71.0.24": "que baixem a barreira em volta do Bosque",
  "96.71.0.25": "de Itora. Asari espera vocês lá.\"",
  "96.71.0.26": "\"Fica logo a leste daqui,",
  "96.71.0.27": "ao norte da encruzilhada.",
  "96.71.0.28": "Não tem erro. Bem, já me",
  "96.71.0.29": "diverti por hoje. Tchau!\"",
  "96.71.0.35": "\"...Vou trazer algo para matar",
  "96.71.0.36": "insetos da próxima vez que vier aqui.\"",
  "96.71.0.44": "\"Volte quando estiver",
  "96.71.0.45": "com o \\c[9]Artefato de Poder\\c[0]!\"",
  "97.16.0.7": "\\s[2]A voz de Asari volta a ser trazida pelo",
  "97.16.0.8": "vento, mas, pela primeira vez, Doren,",
  "97.16.0.9": "Seri Kesu e Adrian conseguem ouvi-la...\\|\\|\\|\\^",
  "97.16.0.31": "\"Finalmente vocês chegaram.\\| A magia",
  "97.16.0.32": "latente aqui na \\c[9]Terra Sagrada\\c[0] permite",
  "97.16.0.33": "que eu me revele a todos vocês...\"",
  "97.16.0.42": "\"Pela Deusa... esta é",
  "97.16.0.43": "Asari...?\\| Ela é... linda...\"",
  "97.16.0.46": "\"...\"",
  "97.16.0.50": "\"Vejo que não estava só falando",
  "97.16.0.51": "sozinha, afinal.\\| Bem, ela é seu",
  "97.16.0.52": "espírito guardião. Pode continuar.\"",
  "97.16.0.55": "\"Certo...\"",
  "97.16.0.60": "\"Esta tem sido uma aventura...",
  "97.16.0.61": "estranha até agora, Asari. Eu realmente",
  "97.16.0.62": "não achei que chegaria tão longe.\"",
  "97.16.0.65": "\"Muitos tentaram antes",
  "97.16.0.66": "de você. Todos falharam.\"",
  "97.16.0.68": "\"Esta é a primeira vez",
  "97.16.0.69": "que alguém tentou quebrar",
  "97.16.0.70": "a \\c[9]Maldição da Pedra\\c[0] e não",
  "97.16.0.71": "caiu nos primeiros dias.\"",
  "97.16.0.72": "\"Quando o Grande Conselho propôs esse",
  "97.16.0.73": "plano em seu desespero, sentimos que não",
  "97.16.0.74": "tínhamos escolha. Talvez não tivéssemos.\"",
  "97.16.0.75": "\"Ao observar o que sofreu",
  "97.16.0.76": "em sua jornada, comecei",
  "97.16.0.77": "a entender o preço...\"",
  "97.16.0.78": "\"Você não merece o que aconteceu,",
  "97.16.0.79": "Lita. E, pela parte que tive",
  "97.16.0.80": "nisso, eu...\\| sinto muito...\"",
  "97.16.0.84": "\"...\\| Sente muito? A última coisa",
  "97.16.0.85": "que eu esperava de você era",
  "97.16.0.86": "um pedido de desculpas...\"",
  "97.16.0.88": "\"Talvez este anel idiota e sua maldição",
  "97.16.0.89": "horrível fossem mesmo a única",
  "97.16.0.90": "coisa que os elfos podiam fazer...\"",
  "97.16.0.92": "\"... mas não sei se algum",
  "97.16.0.93": "dia vou conseguir perdoar",
  "97.16.0.94": "você por fazer isso comigo.\"",
  "97.16.0.97": "\"Não vou pedir que perdoe. Mas chegamos",
  "97.16.0.98": "longe demais para voltar. Vamos",
  "97.16.0.99": "terminar isto. Vamos salvar o mundo.\"",
  "97.16.0.105": "\"Lita, quero apresentar",
  "97.16.0.106": "os outros que fizeram parte",
  "97.16.0.107": "disto. Cirawen e Aldaryn.\"",
  "97.16.0.127": "\"Saudações, Lita LeCotta.",
  "97.16.0.128": "Que as bênçãos da Deusa estejam",
  "97.16.0.129": "com você, heroína dos elfos.\"",
  "97.16.0.132": "\"Sou mesmo indigno, minha senhora.\"",
  "97.16.0.135": "\"...\"",
  "97.16.0.138": "\"Nós a observamos",
  "97.16.0.139": "desde o início.\"",
  "97.16.0.142": "\"Subestimei sua força a cada passo.",
  "97.16.0.143": "Se minhas desculpas significam pouco,",
  "97.16.0.144": "aceite ao menos minha gratidão.\"",
  "97.16.0.147": "\"Não sei se têm tanto assim pelo",
  "97.16.0.148": "que agradecer. Os vampiros",
  "97.16.0.149": "chegaram a \\c[9]Orlian\\c[0] primeiro.\"",
  "97.16.0.155": "\"Vimos o que aconteceu,",
  "97.16.0.156": "Lita. Não foi culpa sua.\"",
  "97.16.0.159": "\"As \\c[9]Pedras da Alma\\c[0] abrem o caminho",
  "97.16.0.160": "para \\c[9]Eldrinor\\c[0], nossa capital antes",
  "97.16.0.161": "de nos transformarmos em pedra.\"",
  "97.16.0.162": "\"É lá que está o sexto e último",
  "97.16.0.163": "\\c[9]Artefato de Poder\\c[0], assim como",
  "97.16.0.164": "o santuário da \\c[9]Pedra Solar\\c[0].\"",
  "97.16.0.167": "\"Talvez haja outro jeito de abrir",
  "97.16.0.168": "os portões de \\c[9]Eldrinor\\c[0], ou talvez ainda",
  "97.16.0.169": "seja possível recuperar as \\c[9]Pedras da Alma\\c[0].\"",
  "97.16.0.170": "\"Enfim, o sol se pôs. Falaremos",
  "97.16.0.171": "mais amanhã. Descansem",
  "97.16.0.172": "aqui, sob nossa proteção.\"",
  "97.16.0.175": "\"As fadas recolocaram seu selo",
  "97.16.0.176": "mágico na entrada do bosque.",
  "97.16.0.177": "Devemos estar seguros.\"",
  "97.16.0.185": "\"Este dia, como a maioria ultimamente,",
  "97.16.0.186": "foi muito longo. Vamos dormir um pouco.",
  "97.16.0.187": "Espero que sem interrupções, para variar.\"",
  "97.16.0.190": "\"... ela é tão bonita...\"",
  "97.16.0.193": "\"Ah, feche a boca, rapaz.",
  "97.16.0.194": "Não nos envergonhe",
  "97.16.0.195": "diante dos elfos.\"",
  "97.16.0.203": "\"Vigiaremos vocês esta noite.",
  "97.16.0.204": "Espero que durmam bem. Pelo",
  "97.16.0.205": "menos isso vocês merecem.\"",
  "97.16.0.207": "\"As fadas prepararam",
  "97.16.0.208": "um lugar para vocês dormirem.\"",
  "97.16.0.219": "\"Ah, fizeram caminhas",
  "97.16.0.220": "de flores para a gente!\"",
  "97.16.0.224": "\"Olá!\"",
  "97.16.0.227": "\"Oi.\\. É bom que não",
  "97.16.0.228": "seja outro truque...\"",
  "97.16.0.231": "\"Desta vez não. Também fizemos",
  "97.16.0.232": "algo gostoso para vocês comerem!\"",
  "97.16.0.250": "\"Ah, uau!\"",
  "97.16.0.253": "\"Legal. Talvez esses insetinhos",
  "97.16.0.254": "nem sejam tão ruins...\"",
  "97.16.0.258": "\"Descansem, heróis de Ara Fell.",
  "97.16.0.259": "Ainda há muito trabalho a fazer.\"",
  "97.16.0.280": "\"Aproveitem!\"",
  "97.16.0.295": "\\s[4]Mais tarde, naquela noite...\\|\\|\\^",
  "97.16.0.312": "\"... Asari.\\| Você me ouve, presumo.",
  "97.16.0.313": "Não imagino que sua forma",
  "97.16.0.314": "espiritual precise muito de sono.\"",
  "97.16.0.320": "\"...\\| Você é perspicaz,",
  "97.16.0.321": "Doren. Sim, posso ouvi-lo.\"",
  "97.16.0.329": "\"Queria falar sobre",
  "97.16.0.330": "o que pretende fazer",
  "97.16.0.331": "com as \\c[9]Pedras da Alma\\c[0].\"",
  "97.16.0.335": "\"Entendo.\\| Como Cirawen",
  "97.16.0.336": "explicou, elas abrirão",
  "97.16.0.337": "os portões selados de \\c[9]Eldrinor\\c[0]...\"",
  "97.16.0.342": "\"Mas fazem mais do que isso. São chamadas",
  "97.16.0.343": "de \\c[9]Pedras da Alma\\c[0] por um motivo.\"",
  "97.16.0.344": "\"Precisam ser energizadas",
  "97.16.0.345": "com o espírito de um ser",
  "97.16.0.346": "vivo. Seu uso custará três",
  "97.16.0.347": "vidas, uma para cada pedra.\"",
  "97.16.0.351": "\"... É verdade.\\| Como",
  "97.16.0.352": "poderia saber disso?\"",
  "97.16.0.357": "\"Pela Deusa, Asari.\\| Realmente",
  "97.16.0.358": "não me reconhece?\"",
  "97.16.0.361": "\"... Sinto muito...\"",
  "97.16.0.367": "\"Muitas vezes me perguntaram,",
  "97.16.0.368": "tanto amigos quanto",
  "97.16.0.369": "inimigos, como sei o que sei...\"",
  "97.16.0.370": "\"Alguém me disse certa vez",
  "97.16.0.371": "que sei mais sobre os elfos",
  "97.16.0.372": "do que qualquer humano poderia...\"",
  "97.16.0.382": "\"Você é um elfo...\\| Ah, Deusa,",
  "97.16.0.383": "eu reconheço você... Rathal!\"",
  "97.16.0.386": "\"...\\| Rathal... Ninguém diz meu nome",
  "97.16.0.387": "em voz alta há muito tempo...",
  "97.16.0.388": "Eu quase o tinha esquecido.\"",
  "97.16.0.389": "\"Mas agora sou Doren. Vivo",
  "97.16.0.390": "disfarçado entre os humanos",
  "97.16.0.391": "há séculos.\\| Os humanos",
  "97.16.0.392": "se tornaram meu povo.\"",
  "97.16.0.395": "\"Você fugiu de \\c[9]Eldrinor\\c[0] quando",
  "97.16.0.396": "a \\c[9]Maldição da Pedra\\c[0] foi lançada... Fugiu",
  "97.16.0.397": "da batalha contra os vampiros...\"",
  "97.16.0.398": "\"Você me abandonou, Rathal.",
  "97.16.0.399": "Eu... eu achava que me amava...\"",
  "97.16.0.403": "\"... Eu amava.\\| Mas achei que o Conselho",
  "97.16.0.404": "estava errado. Ainda acho. Não",
  "97.16.0.405": "participaria da destruição do mundo...\"",
  "97.16.0.406": "\"Mas o que está feito está feito, e o selo",
  "97.16.0.407": "da \\c[9]Pedra Solar\\c[0] precisa ser rompido.",
  "97.16.0.408": "Para isso, precisamos das \\c[9]Pedras",
  "97.16.0.409": "da Alma\\c[0]. E para isso precisamos de almas.\"",
  "97.16.0.411": "\"... Vocês três pretendem usar",
  "97.16.0.412": "os próprios espíritos para energizá-las.\"",
  "97.16.0.417": "\"... Sim.\\| Vivo há tanto tempo",
  "97.16.0.418": "nesta forma, enquanto meu corpo",
  "97.16.0.419": "repousa em pedra em \\c[9]Eldrinor\\c[0].\"",
  "97.16.0.421": "\"A \\c[9]Maldição da Pedra\\c[0] pode enfim ser",
  "97.16.0.422": "quebrada. Meu povo... nosso povo...",
  "97.16.0.423": "pode enfim ser salvo. Os vampiros",
  "97.16.0.424": "podem finalmente ser derrotados.\"",
  "97.16.0.426": "\"Por qual causa mais",
  "97.16.0.427": "nobre se poderia morrer?\"",
  "97.16.0.433": "\"... Por nenhuma.\\|"
}
