{
  "15.9.0.26": "nunca são demais.\"",
  "15.9.0.29": "\"Maravilha. Aqui.\"",
  "15.9.0.32": "Você recebeu um \\c[9]Colar Antigo\\c[0]!\\| É um velho",
  "15.9.0.33": "pingente de lua e espada numa corrente de bronze",
  "15.9.0.34": "manchada. A lua e a espada já foram o símbolo",
  "15.9.0.35": "da tribo que vivia nas \\c[9]Planícies de Seremai\\c[0]...",
  "15.9.0.38": "\"Agora saia de perto de mim.\"",
  "15.9.0.48": "\"Não tinha um fantasma",
  "15.9.0.49": "numa caverna em Seremai",
  "15.9.0.50": "procurando o colar da mãe dele..?\"",
  "15.9.0.54": "Não",
  "15.9.0.57": "\"É, não vou levar",
  "15.9.0.58": "seu lixo por você.\"",
  "15.9.1.2": "\"Será que aquele colar já",
  "15.9.1.3": "serviu para alguma coisa.\"",
  "15.10.0.2": "\"Olá, mocinha. Receio",
  "15.10.0.3": "ter papelada demais",
  "15.10.0.4": "para conversar agora.\"",
  "15.10.0.5": "\"Fale com o senhor Carver",
  "15.10.0.6": "se precisar de algo.\"",
  "15.29.0.3": "Teletransporte dos \\c[9]Pomares de Maçãs\\c[0] liberado!",
  "15.29.2.2": "Parece que o poder deste cristal mágico",
  "15.29.2.3": "foi desativado temporariamente...",
  "15.29.2.9": "Teletransporte dos \\c[9]Pomares de Maçãs\\c[0] liberado!",
  "15.29.2.10": "Parece que o poder deste cristal mágico",
  "15.29.2.11": "foi desativado temporariamente, mas",
  "15.29.2.12": "o local foi ativado para uso posterior.",
  "17.4.0.2": "\"Bom dia, menina. Posso",
  "17.4.0.3": "fazer algo por você?\"",
  "17.7.0.3": "\"Desculpe, menina, não posso conversar",
  "17.7.0.4": "agora. A senhora Maranda encomendou",
  "17.7.0.5": "cem espadas para o exército dela.\"",
  "17.7.1.3": "\"Afaste-se, Lita! Vai levar uma chuva",
  "17.7.1.4": "de faíscas na cara se não tomar cuidado.\"",
  "134.190.0.9": "\"Já tenho tudo que aquela",
  "134.190.0.10": "fazendeira pediu. É melhor",
  "134.190.0.11": "voltar e entregar estes legumes.\"",
  "134.196.0.2": "\"Tem nevado muito ultimamente.",
  "134.196.0.3": "Bom para os campos.\"",
  "134.196.0.4": "\"Ainda bem que a \\c[9]Caverna da Vida\\c[0] mantém",
  "134.196.0.5": "o ar quente o bastante para derreter",
  "134.196.0.6": "a neve antes de chegar ao chão hoje.\"",
  "134.197.0.2": "\"Logo vou ao bazar",
  "134.197.0.3": "com os produtos da colheita.",
  "134.197.0.4": "Talvez a gente se veja lá.\"",
  "134.198.0.2": "\"Já teve aquela sensação de que vem",
  "134.198.0.3": "uma tempestade, mas o céu está limpo?\\|",
  "134.198.0.4": "Bah, talvez eu só esteja paranoico.\"",
  "135.3.0.2": "\"A mamãe diz que havia elfos",
  "135.3.0.3": "em Ara Fell, muito tempo atrás.",
  "135.3.0.4": "Mas todos desapareceram.\"",
  "135.4.0.2": "\"Ei, Lita! Dizem que você é",
  "135.4.0.3": "uma arqueira muito boa, hein?\"",
  "135.4.0.6": "A melhor de todas!",
  "135.4.0.9": "\"Treinei a vida inteira, é",
  "135.4.0.10": "bom que eu seja boa mesmo.\"",
  "135.4.0.13": "\"Ouvi dizer que precisamos",
  "135.4.0.14": "de mais gente para defender a vila",
  "135.4.0.15": "dos vampiros e das criaturas.\"",
  "135.4.0.16": "\"Fico mais tranquilo sabendo",
  "135.4.0.17": "que você está na defesa!\"",
  "135.4.0.19": "Sou razoável...",
  "135.4.0.22": "\"Todo mundo diz",
  "135.4.0.23": "isso, mas não sei...\"",
  "135.4.0.26": "\"Bom, espero que seja tão boa quanto",
  "135.4.0.27": "dizem. Os vampiros estão atacando",
  "135.4.0.28": "as pessoas com mais frequência!\"",
  "135.4.1.2": "\"Se aparecer algum vampiro, transforme",
  "135.4.1.3": "ele numa almofada de alfinetes, tá!\"",
  "136.4.0.3": "\"Obrigada de novo, Lita!\"",
  "136.4.0.8": "\"Lita! Olá! Veio ajudar",
  "136.4.0.9": "na colheita? Eu pago!\"",
  "136.4.0.12": "Claro?",
  "136.4.0.16": "\"É, parece divertido, vamos lá.\"",
  "136.4.0.19": "\"Sério!\"",
  "136.4.0.22": "\"Tanto faz.\"",
  "136.4.0.25": "\"Ótimo! Escute, preciso de alface, tomates,",
  "136.4.0.26": "nabos e rabanetes para fazer o jantar.",
  "136.4.0.27": "Não é muito empolgante, eu acho.\"",
  "136.4.0.28": "\"Torci o tornozelo nos \\c[9]Terrenos",
  "136.4.0.29": "de Caça\\c[0] com meu marido outro",
  "136.4.0.30": "dia, e andar pelos campos",
  "136.4.0.31": "de colheita vai acabar comigo!\"",
  "136.4.0.32": "\"Reúna esses ingredientes para mim",
  "136.4.0.33": "e lhe darei algumas \\c[4]moedas\\c[0] quando",
  "136.4.0.34": "voltar. Muito obrigada, Lita!\"",
  "136.4.0.41": "\"Sabe, na verdade",
  "136.4.0.42": "já tenho tudo...\"",
  "136.4.0.45": "\"Sério!\\. Posso comprar de você??\"",
  "136.4.0.48": "\"Bom, eu meio que...\\.\\. hã, roubei, então...\"",
  "136.4.0.51": "\"Roubou??\\. Bom, preciso mesmo",
  "136.4.0.52": "deles e não tenho tempo para dar",
  "136.4.0.53": "bronca, então passe para cá!\"",
  "136.4.0.54": "\"Aqui está um dinheiro!\"",
  "136.4.0.78": "Hã, não.",
  "136.4.0.81": "\"Eu, hã... tenho muita",
  "136.4.0.82": "coisa para fazer hoje.\"",
  "136.4.0.85": "\"É? Tipo o quê?\"",
  "136.4.0.88": "\"Quer uma lista? Porque",
  "136.4.0.89": "eu tenho uma lista.\"",
  "136.4.0.92": "\"Tá bom, tá bom! Se sobrar",
  "136.4.0.93": "um tempo, eu bem",
  "136.4.0.94": "que preciso de ajuda aqui.\"",
  "136.4.1.6": "\"Pronto, já tem tudo",
  "136.4.1.7": "então? Muito obrigada! Aqui",
  "136.4.1.8": "está algo pelo trabalho.\"",
  "136.4.1.31": "\"Volte quando tiver tudo!",
  "136.4.1.32": "Preciso de nabos, tomates, alface",
  "136.4.1.33": "e rabanetes. Obrigada, Lita!\"",
  "136.4.2.2": "\"Obrigada de novo, Lita!\"",
  "137.5.0.6": "Entrar nas ruínas...",
  "137.5.0.11": "Afastar-se.",
  "138.3.0.2": "\"Você voltou! Já achou",
  "138.3.0.3": "uma boa fantasia?\"",
  "138.3.0.6": "Lutar com ela!",
  "138.3.0.9": "\"Na verdade, decidi que isto é",
  "138.3.0.10": "idiota e vou levar você presa",
  "138.3.0.11": "para a guilda dos patrulheiros!\"",
  "138.3.0.14": "\"O quê? Por quê!\"",
  "138.3.0.17": "\"Você é uma bandida!\"",
  "138.3.0.21": "\"Ah, é, é.\\. Bom, então vai",
  "138.3.0.22": "ter que lutar comigo!\"",
  "138.3.0.25": "\"Com prazer!\"",
  "138.3.0.48": "\"Grr. Você vai me pagar,",
  "138.3.0.49": "sua pirralha intrometida!\"",
  "138.3.0.52": "\"Me chame de 'pirralha' de novo e vai",
  "138.3.0.53": "acabar na parte do \"morta\" dessa",
  "138.3.0.54": "recompensa por você viva ou morta, irmã!\"",
  "138.3.0.58": "Ainda não.",
  "138.3.1.2": "\"Tá, você ganhou. Muito bem.",
  "138.3.1.3": "Só me entregue logo para eu",
  "138.3.1.4": "voltar à civilização, pode ser?\"",
  "138.4.0.4": "\"Ahh! Quem é você??\"",
  "138.4.0.7": "\"Lita.\\.\\. Até tenho medo de perguntar,",
  "138.4.0.8": "mas que roupa é essa?\"",
  "138.4.0.11": "\"Bandida Coelha, ao seu dispor!\\.",
  "138.4.0.12": "Bom, não exatamente. Acho",
  "138.4.0.13": "que vou ter que lutar com você.\"",
  "138.4.0.14": "\"Não posso deixar você revelar meu",
  "138.4.0.15": "incrível esconderijo secreto. Enfim,",
  "138.4.0.16": "estou montando uma guilda de ladrões",
  "138.4.0.17": "mascotes fofinhos.\\| Ei, quer entrar?\"",
  "138.4.0.20": "Claro!",
  "138.4.0.23": "\"Tá bom, estou dentro!",
  "138.4.0.24": "Que mascote posso ser?\"",
  "138.4.0.27": "\"Ah! Não pensei muito nisso!\\.",
  "138.4.0.28": "O que gostaria de ser?\"",
  "138.4.0.31": "Gatinha",
  "138.4.0.34": "\"Orelhas de gato seriam bem fofas!\"",
  "138.4.0.37": "\"Seriam mesmo, você tem razão!",
  "138.4.0.38": "...Bom, não tenho nenhuma",
  "138.4.0.39": "por aqui. Volte se achar.\"",
  "138.4.0.41": "Lobo-raposa",
  "138.4.0.44": "\"Que tal eu me vestir",
  "138.4.0.45": "de lobo-raposa?\"",
  "138.4.0.48": "\"Oooh, assustador. Gostei! Mas",
  "138.4.0.49": "não tenho uma roupa assim",
  "138.4.0.50": "aqui. Volte se achar uma.\"",
  "138.4.0.52": "Gaivota",
  "138.4.0.55": "\"Eu me tornarei uma gaivota.\"",
  "138.4.0.58": "\"Essa é... uma escolha estranha,",
  "138.4.0.59": "mas não vejo por que não! Vai",
  "138.4.0.60": "procurar uma máscara de pássaro?\"",
  "138.4.0.61": "\"Bom, volte se achar!\"",
  "138.4.0.63": "Borboleta",
  "138.4.0.66": "\"Que tal uma borboleta!\"",
  "138.4.0.69": "\"O quê, com asas grandes e esvoaçantes?",
  "138.4.0.70": "É, claro, pode funcionar...\\. Mas",
  "138.4.0.71": "não tenho nenhuma aqui.\"",
  "138.4.0.72": "\"Volte se achar.\"",
  "138.4.0.75": "\"Vou ficar aqui... tentando, hã...",
  "138.4.0.76": "pensar em alguém para roubar,",
  "138.4.0.77": "eu acho.\\. Tchauzinho!\"",
  "138.4.0.82": "Não.",
  "138.4.0.85": "\"Acho que não.\"",
  "138.4.0.88": "\"Bom, então vamos ter que lutar!",
  "138.4.0.89": "Não posso deixar você espalhar",
  "138.4.0.90": "meu plano pela vila inteira!\"",
  "138.4.0.93": "Isso é impressionantemente idiota.",
  "138.4.0.96": "\"Qual é o seu PROBLEMA!",
  "138.4.0.97": "Essa é literalmente a coisa",
  "138.4.0.98": "mais idiota que já ouvi!\"",
  "138.4.0.101": "\"Ei, qual é, não é tão ruim assim!",
  "138.4.0.102": "E não precisa ser grossa!\"",
  "138.4.0.106": "\"É tão ruim assim, sim,",
  "138.4.0.107": "e daqui a pouco vou mostrar",
  "138.4.0.108": "o quanto posso ser grossa!\"",
  "138.4.0.132": "\"Grr. Você vai me pagar,",
  "138.4.0.133": "sua pirralha intrometida!\"",
  "138.4.0.137": "\"Me chame de 'pirralha' de novo e vai",
  "138.4.0.138": "acabar na parte do 'morta' dessa",
  "138.4.0.139": "recompensa por você viva ou morta, irmã!\"",
  "167.23.0.2": "\"Desculpe, menina. O dono dos \\c[9]Pomares",
  "167.23.0.3": "de Maçãs\\c[0] mandou bloquear este lugar.\"",
  "167.23.0.7": "\"Na verdade, ele pediu para eu",
  "167.23.0.8": "investigar. Disse que a entrada",
  "167.23.0.9": "era pequena demais para vocês.\"",
  "167.23.0.12": "\"É? Houve um desabamento",
  "167.23.0.13": "em algum momento, e a entrada",
  "167.23.0.14": "normal foi esmagada.\"",
  "167.23.0.15": "\"O resto parece ter aguentado",
  "167.23.0.16": "bem, então achamos",
  "167.23.0.17": "que... TALVEZ seja seguro. Dê",
  "167.23.0.18": "uma olhada, mas tome cuidado...\"",
  "167.23.0.19": "\"Ninguém entra aqui há",
  "167.23.0.20": "muito tempo. E há coisas",
  "167.23.0.21": "perigosas que gostam",
  "167.23.0.22": "de se esconder em lugares assim.\"",
  "167.24.0.2": "\"Tome cuidado se for",
  "167.24.0.3": "entrar nesta torre, menina.\"",
  "167.25.0.3": "\"O chefe nos mandou vigiar",
  "167.25.0.4": "este lugar para garantir que só",
  "167.25.0.5": "entre quem ele autorizar.\"",
  "167.25.0.6": "\"Só que a entrada está quase toda",
  "167.25.0.7": "desabada. Não vai ser fácil achar alguém",
  "167.25.0.8": "pequeno o bastante para passar...\"",
  "167.25.0.13": "\"Parece que o chefe achou",
  "167.25.0.14": "alguém pequeno o bastante",
  "167.25.0.15": "para passar pela entrada, afinal...\"",
  "167.25.0.18": "\"É, parece que sim.\"",
  "168.20.0.2": "Este baú parece estranho. Tem",
  "168.20.0.3": "certeza de que quer abri-lo?",
  "168.20.0.5": "Sim",
  "168.20.0.33": "\"Lita, se não me engano, este é",
  "168.20.0.34": "um dos 3 cristais que comecei a usar",
  "168.20.0.35": "na minha experiência em Atana.\"",
  "168.20.0.48": "\"Nossa... aquela coisa era assustadora...\"",
  "168.20.0.52": "Não",
  "176.3.0.2": "\"Desculpe, minha... casa",
  "176.3.0.3": "está meio bagunçada...\"",
  "176.5.0.3": "\"Ei, qual é, não fique fuçando",
  "176.5.0.4": "minhas coisas pessoais.\"",
  "176.5.0.9": "\"Este é o diário",
  "176.5.0.10": "do Adrian. Será que leio?\"",
  "176.5.0.13": "Sim",
  "176.5.0.15": "Cansei de ser um pé-rapado. Desde que meus",
  "176.5.0.16": "pais morreram, é difícil ganhar a vida.",
  "176.5.0.17": "Devia ter ouvido melhor as lições da mamãe.",
  "176.5.0.18": "Talvez agora eu possa fazer algo a respeito.",
  "176.5.0.19": "Se esse tesouro for real, se o contato estiver",
  "176.5.0.20": "dizendo a verdade, talvez finalmente consiga",
  "176.5.0.21": "moedas suficientes para impressionar a Lita.",
  "176.5.0.25": "\"... Ele quer me impressionar?\"",
  "176.5.0.30": "Não",
  "238.204.0.11": "\"Então, você é aventureiro, hein, rapaz?\"",
  "238.204.0.14": "\"...\\| Eu? É, acho",
  "238.204.0.15": "que pode dizer isso...\"",
  "238.204.0.19": "\"É assim que ganha a vida? Trabalho",
  "238.204.0.20": "perigoso. Nunca se sabe que tipo",
  "238.204.0.21": "de coisa maligna espreita na escuridão.\"",
  "238.204.0.24": "\"É, bom, lutar é quase a única coisa",
  "238.204.0.25": "que sei fazer, então é isso ou virar",
  "238.204.0.26": "guarda no \\c[9]Castelo de Atana\\c[0].\"",
  "238.204.0.27": "\"Ruínas são mais interessantes.",
  "238.204.0.28": "Além disso, alguém precisa enfrentar",
  "238.204.0.29": "essas coisas malignas, né?\"",
  "238.204.0.32": "\"É, rapaz, acho que alguém precisa mesmo.\"",
  "238.204.0.36": "\"... Não há motivo para esse",
  "238.204.0.37": "'alguém' ser a minha filhinha.\"",
  "242.4.0.2": "\"Guardar maçãs o dia",
  "242.4.0.3": "inteiro faz um homem pensar",
  "242.4.0.4": "se desperdiçou a própria vida.\"",
  "242.5.0.2": "\"Fale com o chefe",
  "242.5.0.3": "se tiver negócios aqui.\"",
  "2.1.2.2": "\"Eu disse para vir aqui.\"",
  "2.1.3.2": "\"É melhor fazer o que ela disse...\"",
  "2.3.1.11": "\"Logo vai escurecer, Lita. Não vou",
  "2.3.1.12": "obrigá-la a ficar, mas, por favor,",
  "2.3.1.13": "volte antes do anoitecer.\"",
  "2.3.1.14": "\"Os vampiros logo sairão",
  "2.3.1.15": "para caçar, e é bem possível",
  "2.3.1.16": "que procurem você.\"",
  "2.3.1.19": "\"Obrigada, vou tomar cuidado. Eu",
  "2.3.1.20": "só... preciso de uns minutos sozinha...\"",
  "2.3.1.32": "\"Vamos deixá-la ir",
  "2.3.1.33": "assim? Com o anel?\"",
  "2.3.1.36": "\"Depois de tudo que passou, acho",
  "2.3.1.37": "que devemos ao menos isso a ela.\"",
  "2.3.1.40": "\"Não se preocupe. Conheço",
  "2.3.1.41": "minha filha. Ela vai voltar.\"",
  "2.5.0.2": "\"Herdei esta mina da minha mãe.",
  "2.5.0.3": "Ela mantinha tudo na linha aqui,",
  "2.5.0.4": "e pretendo seguir seu exemplo.\"",
  "2.6.0.2": "\"Desculpe, menina, sem tempo",
  "2.6.0.3": "para conversar. Temos muitos",
  "2.6.0.4": "pedidos para atender hoje.\"",
  "2.7.1.3": "\"Posso lhe fazer uma pergunta,",
  "2.7.1.4": "menina?\\| Onde encontrou esse anel?\"",
  "2.7.1.7": "\"Hã, bom...\"",
  "2.7.1.10": "\"A verdade, Lita.\"",
  "2.7.1.13": "\"Achei quando eu e o Adrian fomos",
  "2.7.1.14": "explorar umas ruínas ao norte.\"",
  "2.7.1.17": "\"Entendo. Existe um motivo para essas",
  "2.7.1.18": "coisas serem malvistas, Lita. Explorar",
  "2.7.1.19": "ruínas antigas não é brincadeira.\"",
  "2.7.1.20": "\"... Mas eu não poderia ter",
  "2.7.1.21": "previsto algo assim. Ninguém",
  "2.7.1.22": "poderia, imagino, exceto",
  "2.7.1.23": "talvez esse tal Doren.\"",
  "2.7.1.24": "\"Você sempre teve um espírito",
  "2.7.1.25": "aventureiro, Lita. Desde",
  "2.7.1.26": "criança. Isso a meteu",
  "2.7.1.27": "em encrenca mais de uma vez.\"",
  "2.7.1.30": "\"Eu não queria que isso acontecesse...\"",
  "2.7.1.33": "\"Eu sei. E talvez não seja",
  "2.7.1.34": "culpa sua. Você é vítima",
  "2.7.1.35": "do que aconteceu, não a causa.\"",
  "2.7.1.36": "\"A causa é esse anel amaldiçoado.",
  "2.7.1.37": "E os culpados são seus",
  "2.7.1.38": "criadores. Não faz sentido",
  "2.7.1.39": "culpá-la por usar um anel.\"",
  "2.7.1.45": "\"Agora, será que Doren tem mesmo alguma",
  "2.7.1.46": "resposta escondida nestes livros?\"",
  "2.8.0.2": "\"Como está aguentando, Lita?\"",
  "2.8.0.5": "\"A mamãe e o Pentz são estátuas,",
  "2.8.0.6": "o Adrian também... e é tudo culpa minha...\"",
  "2.8.0.9": "\"Não sei se pode mesmo ser culpada",
  "2.8.0.10": "por algo disso. De qualquer modo,",
  "2.8.0.11": "você será forte durante tudo isso.\"",
  "2.8.0.12": "\"Não criei uma covarde nem",
  "2.8.0.13": "uma fracote. Criei você. Se isso é",
  "2.8.0.14": "culpa sua, vai ajudar a consertar.",
  "2.8.0.15": "Se não, vai ajudar como puder.\"",
  "2.8.0.16": "\"E... você e eu vamos seguir em frente",
  "2.8.0.17": "juntos. Aconteça o que acontecer.\"",
  "2.8.0.20": "\"Promete?\"",
  "2.8.0.23": "\"Prometo. Durma",
  "2.8.0.24": "um pouco, minha filha.\"",
  "2.8.1.2": "\"Faremos tudo que pudermos para consertar",
  "2.8.1.3": "isso, para salvar sua mãe e Pentz.",
  "2.8.1.4": "Não vou deixá-la fazer isso sozinha.\"",
  "2.8.3.1": "Lita: Ele não se mexe\\..\\..\\..",
  "2.9.0.2": "\"Então. Lita, não é?\"",
  "2.9.0.5": "\"Sim, senhora.\"",
  "2.9.0.8": "\"Bom, Lita, você mexeu",
  "2.9.0.9": "num belo vespeiro, hein?\"",
  "2.9.0.12": "\"Desculpe, eu não sabia...",
  "2.9.0.13": "Estou me sentindo horrível...\"",
  "2.9.0.16": "\"Ah, acho que pode",
  "2.9.0.17": "culpar os elfos por essa,",
  "2.9.0.18": "em vez de si mesma.\"",
  "2.9.0.19": "\"Falando nisso, acha mesmo",
  "2.9.0.20": "que um espírito élfico falou com você?\"",
  "2.9.0.23": "\"Uma mulher de orelhas pontudas",
  "2.9.0.24": "que era... transparente falou",
  "2.9.0.25": "comigo. Disse que era um espírito.\"",
  "2.9.0.27": "\"Pode ter sido um truque",
  "2.9.0.28": "ou algo assim, eu acho.\"",
  "2.9.0.31": "\"Ha! Seria um truque dos abismos.",
  "2.9.0.32": "Enfim, chega de chorar, senhorita Lita.",
  "2.9.0.33": "Temos muito trabalho pela frente.\"",
  "2.9.0.34": "\"Vamos precisar que seja",
  "2.9.0.35": "forte, seja qual for seu papel",
  "2.9.0.36": "nisso tudo. Entendeu?\"",
  "2.9.0.39": "\"Sim, senhora.\"",
  "2.9.1.2": "\"Tenho certeza de que Doren",
  "2.9.1.3": "esconde bebida em algum",
  "2.9.1.4": "canto por aqui...\"",
  "2.9.3.1": "Seri Kesu: Vá para as Ruínas",
  "2.9.3.2": "de Arei, menina! Não há mais",
  "2.9.3.3": "nada que possa fazer aqui!",
  "2.10.0.2": "\"Então, senhorita Lita LeCotta",
  "2.10.0.3": "de \\c[9]Aloria\\c[0]. Deve ter muitas perguntas.\"",
  "2.10.0.6": "\"Tenho, mas...\\| São",
  "2.10.0.7": "tantas que nem sei",
  "2.10.0.8": "por onde começar...\"",
  "2.10.0.11": "\"Se conseguir organizar os pensamentos,",
  "2.10.0.12": "responderei o que puder, nem",
  "2.10.0.13": "que seja para tranquilizá-la.\"",
  "2.10.0.16": "\"Bom... parece que o senhor",
  "2.10.0.17": "e Doren se conhecem...\"",
  "2.10.0.20": "\"Sim. Na verdade, ele estudou"
}
