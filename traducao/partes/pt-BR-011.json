  "24.254.0.0": "$v Floresta de Sangue - PROIBIDO",
  "24.327.0.2": "\"Por favor, não corra.",
  "24.327.0.3": "Não quero lhe fazer mal.\"",
  "24.339.0.2": "\"Olá, menina! A caça é boa nesta",
  "24.339.0.3": "época do ano. Quer me dar uma mão?\"",
  "24.339.0.6": "Claro!",
  "24.339.0.9": "\"Claro! Eu ia caçar",
  "24.339.0.10": "com meu pai, mas ele...\"",
  "24.339.0.12": "\"... bom, se machucou.",
  "24.339.0.13": "Então vou ajudar você.\"",
  "24.339.0.16": "\"Sinto muito por isso,",
  "24.339.0.17": "mas agradeço a ajuda.\"",
  "24.339.0.18": "\"Às vezes, os terrenos de caça",
  "24.339.0.19": "ficam infestados de \\c[9]lobos-raposa\\c[0]",
  "24.339.0.20": "e \\c[9]gatos lunares\\c[0]. Se ajudar a reduzir",
  "24.339.0.21": "um pouco o número deles, eu pago.\"",
  "24.339.0.22": "Traga 10 \\c[9]Caudas de Gato",
  "24.339.0.23": "Estelar\\c[0]. Vou esperar",
  "24.339.0.24": "bem aqui até conseguir!\"",
  "24.339.0.28": "Estou ocupada demais.",
  "24.339.0.31": "\"Desculpe, não posso agora.\"",
  "24.339.0.34": "\"Ahh, não se preocupe.",
  "24.339.0.35": "Ficaremos aqui mais um tempo",
  "24.339.0.36": "se precisar de algo para fazer.\"",
  "24.339.1.3": "\"Ei! Conseguiu 10 caudas, hein? Muito",
  "24.339.1.4": "bem. Isso deve deixar as coisas mais",
  "24.339.1.5": "seguras para quem viaja por aqui.\"",
  "24.339.1.6": "\"Aqui, você mereceu.\"",
  "24.339.1.18": "\"Me avise quando juntar 10",
  "24.339.1.19": "\\c[9]Caudas de Gato Estelar\\c[0], hein?\"",
  "24.339.2.2": "\"Isso deve reduzir o número",
  "24.339.2.3": "dessas criaturas. Obrigado",
  "24.339.2.4": "por dedicar um tempo a ajudar!\"",
  "24.340.0.0": "O anão saúda você num grunhido impaciente.",
  "24.360.0.2": "\"Por favor, não corra.",
  "24.360.0.3": "Não quero lhe fazer mal.\"",
  "24.361.0.2": "\"Por favor, não corra.",
  "24.361.0.3": "Não quero lhe fazer mal.\"",
  "24.372.0.2": "\"Por favor, não corra.",
  "24.372.0.3": "Não quero lhe fazer mal.\"",
  "25.7.0.2": "Prosseguir...",
  "25.7.0.18": "Ainda não.",
  "25.17.0.2": "\"Há muitos tesouros escondidos",
  "25.17.0.3": "em cavernas como estas.\"",
  "25.17.0.4": "\"Procure nelas",
  "25.17.0.5": "se quiser algum saque.\"",
  "25.19.0.0": "Alojamento dos Mineiros",
  "25.20.0.0": "AVISO! Esta seção está",
  "25.20.0.1": "inundada - Acesso Proibido",
  "25.21.0.2": "\"A competição anual de arco e flecha",
  "25.21.0.3": "acontece a sudeste do \\c[9]Castelo de Atana\\c[0].",
  "25.21.0.4": "Tarim Vizur sempre participa.\"",
  "25.21.0.5": "\"Ele é um dos melhores",
  "25.21.0.6": "arqueiros destas terras.\"",
  "25.22.0.2": "\"Às vezes vejo um sujeito",
  "25.22.0.3": "estranho entrando escondido",
  "25.22.0.4": "na mina abandonada...\\| Sinistro.\"",
  "25.23.0.2": "\"Não é tão ruim aqui, de verdade. Depois",
  "25.23.0.3": "de um tempo você se acostuma a cavar.\"",
  "25.24.0.2": "\"Hum, parece bloqueado...\"",
  "25.104.0.2": "\"Lita, aí está você.\\.\\. Pode",
  "25.104.0.3": "chegar à minha casa",
  "25.104.0.4": "por esta mina abandonada.\"",
  "25.104.0.5": "\"Basta passar por baixo da barricada.\"",
  "25.105.0.1": "\"Olá, mocinha! Veio minerar",
  "25.105.0.2": "cristais, hein?? Pegue",
  "25.105.0.3": "um cinzel e mãos à obra!\"",
  "25.131.0.3": "Você desbloqueou o teletransporte da \\c[9]Pedreira\\c[0]!",
  "25.131.2.2": "Parece que o poder deste cristal mágico",
  "25.131.2.3": "foi desativado temporariamente...",
  "25.131.2.9": "Você desbloqueou o teletransporte da \\c[9]Pedreira\\c[0]!",
  "25.131.2.10": "Parece que o poder deste cristal mágico",
  "25.131.2.11": "foi desativado temporariamente, mas",
  "25.131.2.12": "o local foi ativado para uso posterior.",
  "25.134.0.13": "\"Ah... minha cabeça. O que aconteceu?\"",
  "25.134.0.17": "\"Onde... onde estou? Quem é você?\"",
  "25.134.0.20": "\"Pode parecer meio louco, mas você",
  "25.134.0.21": "foi transformada em pedra há muito",
  "25.134.0.22": "tempo. Acabei de desfazer isso.\"",
  "25.134.0.26": "\"Transformada em pedra? Isso é...",
  "25.134.0.27": "eu... por quanto tempo fiquei assim..?\"",
  "25.134.0.30": "\"Não sei. Provavelmente muito tempo.\"",
  "25.134.0.34": "\"Eu... o-obrigada, preciso ir...",
  "25.134.0.35": "encontrar minha família...\"",
  "25.134.0.41": "\"Parece que ela não entendeu.\\|",
  "25.134.0.42": "Ou talvez não tenha acreditado.\"",
  "25.220.0.2": "\"Humpf! É isso que vocês chamam",
  "25.220.0.3": "de mina? Cavam um buraquinho",
  "25.220.0.4": "no chão e tiram umas pedras? HUM??\"",
  "25.220.0.5": "\"Vocês humanos não reconheceriam",
  "25.220.0.6": "um bom minério nem se caísse",
  "25.220.0.7": "do céu e acertasse suas cabeças!\"",
  "25.220.1.0": "Este anão resmunga irritado sobre a",
  "25.220.1.1": "incompetência humana na arte da metalurgia.",
  "26.2.0.2": "\"A senhora Maranda mandou fazer",
  "26.2.0.3": "muitas reformas no castelo quando",
  "26.2.0.4": "assumiu o lugar do rei Aragon.\"",
  "26.2.0.5": "\"Isso nos mantém bem",
  "26.2.0.6": "ocupados, mantém mesmo.\"",
  "26.3.0.2": "\"As minas lá dos fundos inundaram",
  "26.3.0.3": "e desabaram há algum tempo.\"",
  "26.3.0.4": "\"Há boatos de um sujeito",
  "26.3.0.5": "que anda se esgueirando por lá.",
  "26.3.0.6": "Um bandido ou algo assim.\"",
  "26.4.0.2": "\"Faço isso há 52 anos! Desde",
  "26.4.0.3": "antes de vampiros, fadas",
  "26.4.0.4": "e pombos virarem moda.\"",
  "26.5.0.2": "\"Levo água aos mineiros! Um dia",
  "26.5.0.3": "vou cortar pedras igual a eles!\"",
  "31.1.1.2": "Voltar à entrada",
  "31.1.1.10": "Voltar à sala anterior",
  "31.3.0.3": "\"Hã, olá... você é o 'monstro'",
  "31.3.0.4": "de que aquela criança espírito falou?\"",
  "31.3.0.7": "\"...\"",
  "31.3.0.10": "\"E então? Vamos. Não",
  "31.3.0.11": "vai me atacar nem nada?\"",
  "31.3.0.14": "\"...\"",
  "31.3.0.21": "\"O que devo fazer?\"",
  "31.3.0.23": "Lutar com o espírito.",
  "31.3.0.25": "\"Tá bom, vamos nessa.\"",
  "31.3.0.33": "\"... Enfim, estou livre...\"",
  "31.3.0.38": "\"Finalmente\\..\\..\\.. livre\\..\\..\\..\"",
  "31.3.0.44": "\"Aquele colar amaldiçoado parece...",
  "31.3.0.45": "mais brilhante, de algum jeito.\\| É melhor",
  "31.3.0.46": "levar de volta à criança espírito.\"",
  "31.3.0.49": "Sair.",
  "31.3.0.51": "\"Talvez eu volte mais tarde.\"",
  "31.5.1.2": "Voltar à entrada",
  "31.5.1.10": "Voltar à sala anterior",
  "31.7.1.1": "Voltar à entrada",
  "31.7.1.8": "Voltar à sala anterior",
  "32.36.0.16": "\"Nossa, está um breu aqui...\"",
  "32.36.0.21": "\"Vou precisar de luz.\"",
  "32.36.0.27": "\"Nem toda caverna é escura demais",
  "32.36.0.28": "para enxergar sem luz. Talvez encontre",
  "32.36.0.29": "algo para iluminar o caminho nesta.\"",
  "32.37.0.15": "\"Nossa, está um breu aqui...\"",
  "32.37.0.20": "\"Vou precisar de luz ou algo assim...\"",
  "32.37.0.26": "Nem toda caverna é escura demais",
  "32.37.0.27": "para enxergar sem luz. Talvez encontre",
  "32.37.0.28": "algo para iluminar o caminho nesta.",
  "32.38.0.7": "Você encontrou uma \\c[9]lanterna\\c[0]! Use",
  "32.38.0.8": "este item para iluminar salas escuras!",
  "32.38.1.0": "O baú está vazio.",
  "32.45.0.2": "\"Parece uma porta,",
  "32.45.0.3": "mas foi bloqueada...\"",
  "32.45.1.6": "Uma batalha difícil vem pela frente. Prepare",
  "32.45.1.7": "bem seus equipamentos! \\c[9]Poções de Vida\\c[0]",
  "32.45.1.8": "e equipamentos melhorados são essenciais!",
  "32.45.1.9": "Se lutar e perder, fique mais forte e volte!",
  "32.45.1.10": "A maioria dos combates pode ser evitada, então",
  "32.45.1.11": "talvez precise treinar para ganhar níveis.",
  "32.45.1.22": "Prosseguir...",
  "32.45.1.35": "\"O que... o que é tudo isto?\"",
  "32.45.1.37": "\"São os bichinhos de todo mundo!?\"",
  "32.45.1.40": "\"Pelos abismos. Nem quero saber",
  "32.45.1.41": "por que Arger os mantém aqui embaixo...\"",
  "32.45.1.45": "\"Bom, vou descobrir!",
  "32.45.1.46": "E Arger vai pagar",
  "32.45.1.47": "se pegou meu gato!\"",
  "32.45.1.52": "\"Pareceu o Percy!\"",
  "32.45.1.59": "Prosseguir, pulando a cena.",
  "32.45.1.68": "Voltar.",
  "32.49.1.12": "\"Nossa, está um breu aqui...\"",
  "32.49.1.17": "\"Vou precisar de luz.\"",
  "32.49.1.23": "Nem toda caverna é escura demais",
  "32.49.1.24": "para enxergar sem luz. Talvez encontre",
  "32.49.1.25": "algo para iluminar o caminho nesta.",
  "32.52.0.8": "\"Que estranho... Não sabia desta",
  "32.52.0.9": "caverna sob a casa do senhor Arger...\"",
  "32.52.0.12": "\"É, e também parece perigosa...",
  "32.52.0.13": "Cuidado com aquelas cobras.\"",
  "32.56.0.7": "\"... o que ainda estou fazendo aqui embaixo?\"",
  "32.56.0.11": "\"Nossa... Quem diria que esta caverna",
  "32.56.0.12": "enorme ficava debaixo da casa do senhor",
  "32.56.0.13": "Arger?\\| Enfim, precisa de algo?\"",
  "32.95.0.1": "Usar bomba.",
  "32.95.0.6": "Deixar como está.",
  "32.97.0.8": "\"Hum, tem três botões aqui...\"",
  "32.97.0.11": "\"Acho que reconheço este mecanismo. É",
  "32.97.0.12": "uma medida de segurança. Tem que saber",
  "32.97.0.13": "a combinação certa para apertar.\"",
  "32.97.0.14": "\"São só três. Talvez possamos",
  "32.97.0.15": "adivinhar a combinação.\"",
  "32.98.0.2": "\"E então? Vá buscar seu gato!\"",
  "32.98.1.9": "\"Certo, quer explicar",
  "32.98.1.10": "que diabos é tudo isto, Arger?\"",
  "32.98.1.13": "\"É melhor responder rápido! Por que meu",
  "32.98.1.14": "gato está nesta... prisão de bichinhos?!\"",
  "32.98.1.17": "\"Que a Deusa amaldiçoe vocês. Não tenho",
  "32.98.1.18": "tempo para isso. Azatel está quase pronto...\""
}
