  "24.173.1.27": "\"Certo.\"",
  "24.177.0.10": "\"Papai! Onde está?!\"",
  "24.177.0.13": "\"Hum, isto está mais",
  "24.177.0.14": "difícil do que pensei.\"",
  "24.177.1.10": "\"Papai! Onde está?!\"",
