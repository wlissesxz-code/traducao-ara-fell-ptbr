  "40.15.1.3": "\"Há um anjo gravado",
  "40.15.1.4": "nesta tocha.\\| Hmm.\\| Acho",
  "40.15.1.5": "que consigo empurrá-la...\"",
  "40.21.0.3": "\"Há um anjo gravado",
