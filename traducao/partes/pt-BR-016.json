  "40.27.0.1": "A cor do Sangue",
  "40.27.0.2": "Antes da cor",
  "40.27.0.3": "dos Sóis A cor do Céu",
  "40.27.0.4": "E a das Ameixas depois",
  "40.27.0.9": "\"... Eu odeio este lugar.\"",
  "40.27.0.16": "Você pode ativar o modo \\c[4]Daltonismo\\c[0]",
  "40.27.0.17": "na seção \\c[4]Configurações\\c[0] do \\c[4]Menu\\c[0],",
